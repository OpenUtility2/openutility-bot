# Required
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id

# Optional OpenUtility channels
SUGGESTIONS_CHANNEL_ID=
BUGS_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=

# OpenUtility / Discord
DISCORD_INVITE_URL=https://discord.gg/ufvQ4Ghtpu
DEFAULT_PREFIX=!

# GitHub integration / website maintenance
GITHUB_REPO=OpenUtility2/openutility
GITHUB_TOKEN=

# Authenticated bot webhook endpoint
WEBHOOK_SECRET=

# Runtime / storage
PORT=3000
OU_DATA_DIR=./data

# Minecraft monitoring
MC_MONITOR_POLL_MS=300000

# GitHub update polling
GITHUB_POLL_MS=300000
